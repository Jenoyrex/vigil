# Copy to .env.local for local development. Never commit a real .env.local file.
#
# Both variables are read only server-side (lib/api/vigilClient.ts, guarded
# by `import "server-only"`) -- never prefix these with NEXT_PUBLIC_, which
# would bundle them into browser-visible code.

# Base URL of the Vigil FastAPI backend (see apps/api).
VIGIL_API_BASE_URL=http://127.0.0.1:8000

# A Vigil API key for the project this dashboard should display. Mint one
# locally with `uv run python scripts/seed_local_api_key.py` from apps/api.
VIGIL_API_KEY=vgl_replace-with-your-local-dev-key

# Optional. Lets the login route report the end-user IP to the API for
# per-IP login rate limiting. Must equal the API's
# VIGIL_API_DASHBOARD_CLIENT_IP_TOKEN; leave empty to disable.
VIGIL_API_DASHBOARD_CLIENT_IP_TOKEN=

# Number of trusted reverse proxies in front of the dashboard (0 = none,
# the default). The client IP is taken from X-Forwarded-For only when this
# is >= 1, as the Nth entry from the right -- the one your own outermost
# proxy appended. Never set it higher than the real number of proxies:
# the entries to its left are client-controlled.
VIGIL_DASHBOARD_TRUSTED_PROXY_HOPS=0
