# Copy to .env for local overrides. Never commit a real .env file.
# Matches the default credentials in infrastructure/docker-compose.yml.

VIGIL_API_DATABASE_URL=postgresql+psycopg://vigil:vigil@localhost:5434/vigil

# Used only by the test suite (see tests/conftest.py), pointing at the
# separate vigil_test database created by infrastructure/postgres/init-test-db.sh.
VIGIL_API_TEST_DATABASE_URL=postgresql+psycopg://vigil:vigil@localhost:5434/vigil_test
