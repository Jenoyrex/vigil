# Copy to .env for local overrides. Never commit a real .env file.
# Matches the default credentials in infrastructure/docker-compose.yml.
#
# Every key below corresponds exactly to one field on apps/api/app/config.py's
# Settings class (VIGIL_API_ + the field name, uppercased) -- see
# apps/api/tests/test_env_example.py, which asserts this file never drifts
# from that class again.

VIGIL_API_APP_NAME=Vigil API

VIGIL_API_DATABASE_URL=postgresql+psycopg://vigil:vigil@localhost:5434/vigil

# Used only by the test suite (see tests/conftest.py), pointing at the
# separate vigil_test database created by infrastructure/postgres/init-test-db.sh.
VIGIL_API_TEST_DATABASE_URL=postgresql+psycopg://vigil:vigil@localhost:5434/vigil_test

# ClickHouse (telemetry storage, see infrastructure/clickhouse/). Defaults
# match infrastructure/.env.example's CLICKHOUSE_* values.
VIGIL_API_CLICKHOUSE_HOST=localhost
VIGIL_API_CLICKHOUSE_PORT=8123
VIGIL_API_CLICKHOUSE_DATABASE=vigil
VIGIL_API_CLICKHOUSE_USER=vigil
VIGIL_API_CLICKHOUSE_PASSWORD=vigil
VIGIL_API_CLICKHOUSE_TIMEOUT_SECONDS=10.0

# Telemetry ingestion payload limits (docs/decisions/003-clickhouse-telemetry-storage.md).
VIGIL_API_MAX_SPANS_PER_REQUEST=1000
VIGIL_API_MAX_REQUEST_BODY_BYTES=10485760
VIGIL_API_MAX_INPUT_BYTES=65536
VIGIL_API_MAX_OUTPUT_BYTES=65536
VIGIL_API_MAX_TOTAL_SPAN_BYTES=262144

# Query API (read-side) safety limits, for the Trace Explorer/analytics
# endpoints (GET /v1/traces*, GET /v1/analytics/*).
VIGIL_API_MAX_QUERY_WINDOW_DAYS=7
VIGIL_API_DEFAULT_QUERY_WINDOW_HOURS=24
VIGIL_API_MAX_SPANS_PER_TRACE_RESPONSE=2000

# REQUIRED -- no Python default (app/config.py). Must be set to *some* value
# in every environment, local development included, or the app refuses to
# start. Must match services/worker's own VIGIL_WORKER_INTERNAL_SERVICE_TOKEN
# exactly -- both sides of the same shared secret
# (docs/decisions/005-evaluation-job-storage-worker.md section 9). The value
# below is an obvious local-only placeholder, not a real secret; generate a
# real random value for anything beyond local development.
VIGIL_API_INTERNAL_SERVICE_TOKEN=local-dev-internal-token-change-me
