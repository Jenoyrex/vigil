# Production environment template for
# infrastructure/docker-compose.prod.yml.
#
# Copy to infrastructure/.env.production and fill in real values. NEVER
# commit the filled-in file, and never place real secrets in this example
# file -- every value below is a placeholder, not a working default.
# Unlike infrastructure/.env.example (local development), nothing here has
# an insecure convenience default baked into the compose file itself: every
# variable is required at `docker compose up` time.
#
# Usage (from the repository root):
#   docker compose -f infrastructure/docker-compose.prod.yml \
#     --env-file infrastructure/.env.production up -d --build

# --- PostgreSQL (used to construct the two DATABASE_URL values below) ---
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vigil

# --- ClickHouse ---
CLICKHOUSE_USER=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DB=vigil

# --- apps/api (VIGIL_API_* prefix, see apps/api/app/config.py) ---
# psycopg/SQLAlchemy DSN, pointed at the `postgres` service on the Compose
# network (not localhost, and not the host-published port -- there isn't
# one in production). Must use the same POSTGRES_USER/PASSWORD/DB values
# set above.
VIGIL_API_DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@postgres:5432/vigil
VIGIL_API_CLICKHOUSE_HOST=clickhouse
VIGIL_API_CLICKHOUSE_PORT=8123
VIGIL_API_CLICKHOUSE_DATABASE=vigil
VIGIL_API_CLICKHOUSE_USER=CHANGE_ME
VIGIL_API_CLICKHOUSE_PASSWORD=CHANGE_ME
# Shared secret -- see "Internal service token" below. Must be identical
# to VIGIL_WORKER_INTERNAL_SERVICE_TOKEN.
VIGIL_API_INTERNAL_SERVICE_TOKEN=CHANGE_ME

# Per-API-key rate limiting (Phase 4C, see apps/api/app/api/rate_limit.py
# and apps/api/README.md's "Rate limiting" section). Limits apply per API
# key (AuthenticatedKey.api_key_id), not per project or globally. Ingestion
# (POST /v1/traces) has the stricter tier; every other authenticated
# customer endpoint shares the more generous default tier. These are
# starting-point defaults carried over from apps/api/app/config.py's own
# Python defaults, not load-tested production values -- there is no
# production traffic history yet to calibrate against. Enforcement is
# entirely in-process: each `api` replica tracks its own independent
# buckets, with no shared store across replicas (today's topology runs
# exactly one `api` replica, so this is a real, correctly-enforced limit).
VIGIL_API_RATE_LIMIT_INGESTION_CAPACITY=20
VIGIL_API_RATE_LIMIT_INGESTION_REFILL_PER_SECOND=5.0
VIGIL_API_RATE_LIMIT_DEFAULT_CAPACITY=60
VIGIL_API_RATE_LIMIT_DEFAULT_REFILL_PER_SECOND=20.0
VIGIL_API_RATE_LIMIT_MAX_TRACKED_API_KEYS=10000

# --- services/worker (VIGIL_WORKER_* prefix, shared by both the `worker`
# and `poller` Compose services -- see services/worker/worker/config.py) ---
# Plain psycopg conninfo DSN (no `+psycopg` dialect prefix, unlike
# VIGIL_API_DATABASE_URL above -- see worker/config.py's own comment on
# why), same target database as VIGIL_API_DATABASE_URL.
VIGIL_WORKER_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@postgres:5432/vigil
VIGIL_WORKER_CLICKHOUSE_HOST=clickhouse
VIGIL_WORKER_CLICKHOUSE_PORT=8123
VIGIL_WORKER_CLICKHOUSE_DATABASE=vigil
VIGIL_WORKER_CLICKHOUSE_USER=CHANGE_ME
VIGIL_WORKER_CLICKHOUSE_PASSWORD=CHANGE_ME
# Shared secret -- see "Internal service token" below. Must be identical
# to VIGIL_API_INTERNAL_SERVICE_TOKEN.
VIGIL_WORKER_INTERNAL_SERVICE_TOKEN=CHANGE_ME
# The poller calls apps/api's internal job-creation endpoint over HTTP;
# `api` here is the Compose service name/DNS entry, not localhost.
VIGIL_WORKER_API_BASE_URL=http://api:8000

# --- apps/dashboard (server-only; never prefix with NEXT_PUBLIC_) ---
VIGIL_API_BASE_URL=http://api:8000
# A real Vigil API key for the project this dashboard should display.
# Provisioning is currently script-based only (apps/api/scripts/
# seed_local_api_key.py) -- there is no HTTP-based key-issuance endpoint
# yet (tracked as a known gap, out of Phase 4B's scope). Run that script
# against the production database to mint one, then place it here.
VIGIL_API_KEY=CHANGE_ME

# --- Registry images (Phase 4D, F7) ---
# NOT secrets -- these are the three registry image references
# docker-compose.prod.yml's `image:` fields require (a required variable
# with no default, so a bare `docker compose up` with none of these set
# fails immediately rather than silently resolving nothing/`latest`). They
# are deliberately left unset here in the *example* file, and should
# normally stay unset in the real infrastructure/.env.production on the
# deploy host too: .github/workflows/cd.yml's deploy job sets all three in
# the invoking shell's environment for the duration of each deploy (which
# takes precedence over --env-file for Compose variable substitution),
# always to the one immutable `sha-<40-char-commit>` tag being deployed --
# see docs/decisions/006-deployment-architecture.md, decision 13. Baking a
# fixed value into infrastructure/.env.production here would silently
# become a stale, unintentional default the moment it's no longer the tag
# actually being deployed.
#
# Only set these yourself for a manual, non-CD invocation, e.g.:
#   VIGIL_API_IMAGE=ghcr.io/<owner>/vigil-api:sha-<commit>
#   VIGIL_DASHBOARD_IMAGE=ghcr.io/<owner>/vigil-dashboard:sha-<commit>
#   VIGIL_WORKER_IMAGE=ghcr.io/<owner>/vigil-worker:sha-<commit>
# (shared by both the `worker` and `poller` services)
# or, for a pure local `--build` test with no registry involved at all, any
# validly-shaped placeholder reference -- `build:` will tag the built image
# with whatever you set here rather than pulling it.

# --- Internal service token ---
# One shared secret, generated once (e.g. `openssl rand -hex 32`), used as
# BOTH VIGIL_API_INTERNAL_SERVICE_TOKEN and
# VIGIL_WORKER_INTERNAL_SERVICE_TOKEN above -- apps/api validates every
# request to POST /v1/evaluations/jobs against its own copy
# (apps/api/app/api/deps.py's get_internal_service_auth), and
# services/worker's poller sends its own copy on every such request
# (services/worker/worker/poller.py). If the two values ever diverge, the
# poller can no longer create evaluation jobs and every request fails
# authentication -- there is no partial-compatibility mode.
