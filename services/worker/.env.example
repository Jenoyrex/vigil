# Copy to .env for local overrides. Never commit a real .env file.
# Matches the default credentials in infrastructure/docker-compose.yml.
#
# Every key below corresponds exactly to one field on
# services/worker/worker/config.py's Settings class (VIGIL_WORKER_ + the
# field name, uppercased) -- see services/worker/tests/test_env_example.py,
# which asserts this file never drifts from that class again.
#
# Two independent processes read this file: `python -m worker` (the
# claim/dispatch/reap runtime, worker/__main__.py) and
# `python -m worker.poller_main` (the ClickHouse-scanning poller) --
# every setting below is shared by both, per worker/config.py's own Settings
# class (there is only one).

# ClickHouse (telemetry storage read by the poller; evaluation_results
# storage written by the runtime). Defaults match infrastructure/.env.example's
# CLICKHOUSE_* values -- same database apps/api/.env.example points at.
VIGIL_WORKER_CLICKHOUSE_HOST=localhost
VIGIL_WORKER_CLICKHOUSE_PORT=8123
VIGIL_WORKER_CLICKHOUSE_DATABASE=vigil
VIGIL_WORKER_CLICKHOUSE_USER=vigil
VIGIL_WORKER_CLICKHOUSE_PASSWORD=vigil
VIGIL_WORKER_CLICKHOUSE_TIMEOUT_SECONDS=10.0

# PostgreSQL (evaluation_jobs/evaluator_configs/evaluation_poller_checkpoint)
# -- a plain psycopg conninfo URL (no `+psycopg` dialect prefix), unlike
# apps/api's SQLAlchemy-style VIGIL_API_DATABASE_URL, though it points at the
# same local database by default.
VIGIL_WORKER_DATABASE_URL=postgresql://vigil:vigil@localhost:5434/vigil

# Bounded-concurrency dispatch (worker/dispatcher.py).
VIGIL_WORKER_MAX_CONCURRENT_EVALUATIONS=4

# Per-call evaluator timeout (Phase 4A, worker/execution.py) -- bounds one
# evaluate() call. Separate from, and tighter than, the initialization
# timeout below: steady-state inference vs. one-time model construction.
VIGIL_WORKER_EVALUATOR_CALL_TIMEOUT_SECONDS=30.0

# First-use evaluator construction timeout (Phase 4A, worker/registry.py) --
# deliberately more generous, to cover a cold-cache model download.
VIGIL_WORKER_EVALUATOR_INIT_TIMEOUT_SECONDS=90.0

# Bounded-orphan self-restart (Phase 4A, worker/timeouts.py,
# worker/runtime.py) -- once this many timed-out evaluator calls are
# simultaneously still outstanding (abandoned, not stopped -- Python cannot
# forcibly kill a thread), this worker process requests its own graceful
# shutdown rather than leaking indefinitely. Requires an external process
# supervisor (systemd/Docker/Kubernetes restart policy) to bring up a fresh
# replacement -- this setting only decides when to retire, never how the
# process comes back.
VIGIL_WORKER_MAX_ORPHANED_EVALUATOR_THREADS=4

# Retry/backoff (worker/failure_handling.py): delay_seconds =
# min(retry_max_delay_seconds, retry_base_seconds * (2 ** (attempt_count - 1)))
# + random.uniform(0, retry_jitter_seconds).
VIGIL_WORKER_RETRY_BASE_SECONDS=5.0
VIGIL_WORKER_RETRY_MAX_DELAY_SECONDS=300.0
VIGIL_WORKER_RETRY_JITTER_SECONDS=2.0

# Stuck-job reaper (worker/reaper.py) -- catches a claimed job whose worker
# process died outright; must stay meaningfully larger than any genuine
# evaluator call, including the per-call timeout below.
VIGIL_WORKER_STUCK_JOB_THRESHOLD_SECONDS=900.0
VIGIL_WORKER_REAPER_BATCH_SIZE=100

# Worker runtime loop (python -m worker, worker/runtime.py).
VIGIL_WORKER_CLAIM_BATCH_SIZE=4
VIGIL_WORKER_POLL_INTERVAL_SECONDS=2.0
VIGIL_WORKER_REAPER_INTERVAL_SECONDS=60.0

# Evaluation job poller (python -m worker.poller_main, worker/poller.py) --
# a fully independent process from the runtime above; scans ClickHouse
# `spans` and creates `evaluation_jobs` rows via apps/api.
VIGIL_WORKER_POLLER_BATCH_SIZE=500
VIGIL_WORKER_POLLER_OVERLAP_SECONDS=60.0
VIGIL_WORKER_POLLER_START_TIME_LOOKBACK_DAYS=3
VIGIL_WORKER_POLLER_INTERVAL_SECONDS=30.0
VIGIL_WORKER_POLLER_JOB_CREATION_TIMEOUT_SECONDS=10.0

# REQUIRED -- no Python default (worker/config.py). Must be set to *some*
# value in every environment, local development included, or the app
# refuses to start. Must match apps/api's own
# VIGIL_API_INTERNAL_SERVICE_TOKEN exactly -- both sides of the same shared
# secret (docs/decisions/005-evaluation-job-storage-worker.md section 9).
# The value below is an obvious local-only placeholder, not a real secret;
# generate a real random value for anything beyond local development.
VIGIL_WORKER_INTERNAL_SERVICE_TOKEN=local-dev-internal-token-change-me

# Base URL of apps/api, used by the poller to call
# POST /v1/evaluations/jobs with the internal token above.
VIGIL_WORKER_API_BASE_URL=http://localhost:8000
